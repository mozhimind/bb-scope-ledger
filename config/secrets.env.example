# Optional API tokens for the direct sources. Copy to config/secrets.env (that file is never committed) and fill in what you have.
# Without them the run still works: the public sources and the keyless parts of the direct sources are used.
# H1_USERNAME=
# H1_TOKEN=
# INTIGRITI_TOKEN=
# YWH_TOKEN=
# HACKENPROOF=
# Other settings are documented in the README (BB_STALE_DAYS, BB_DISABLE, BB_DIRECT_BUDGET ...), e.g.:
# BB_DISABLE=arkadiyt-domains,arkadiyt-hackerone
